# Copy to .env on the host (never commit .env). chmod 600.
# Secrets are read once at start-up and live only in this file.

# Random, at least 32 characters. Generate: openssl rand -base64 48
HS_SECRET=

# Where moderation links and source-check reports go. Also the only address
# that can request a moderation login link.
HS_ADMIN_EMAIL=

# Outbound mail. With HS_SMTP_HOST empty the API delivers straight to each
# recipient's MX on port 25 (STARTTLS when offered, DKIM-signed) and needs no
# account anywhere. For that to be trusted the zone must carry the SPF, DKIM
# and DMARC records the API asks for: publish them with
#   HA_TOKEN=... python docs/dns-setup.py --mail
# and ask the ISP for a PTR on HS_MAIL_IP (Gmail refuses port 25 without one).
# The System page in the console checks every record live.
#
# Alternative: an authenticated submission relay (587 STARTTLS or 465 TLS),
# e.g. Brevo free tier: HS_SMTP_HOST=smtp-relay.brevo.com HS_SMTP_PORT=587,
# user = login, pass = SMTP key. Messages are still DKIM-signed with our key.
HS_SMTP_HOST=
HS_SMTP_PORT=587
HS_SMTP_USER=
HS_SMTP_PASS=
HS_MAIL_FROM=Helderberg Social <hello@helderbergsocial.co.za>
# Public address mail leaves from (goes into the SPF record and the PTR check).
HS_MAIL_IP=41.221.5.36
# EHLO name for direct delivery; defaults to the HS_API_URL host. Make it the
# name that resolves to HS_MAIL_IP and that the ISP's PTR on HS_MAIL_IP names,
# so HELO, forward and reverse DNS all agree (dns-setup.py --mail adds the A).
HS_MAIL_HELO=mail.helderbergsocial.co.za
# DKIM selector. The 2048-bit key is generated on first start into the data
# volume (dkim-<selector>.key); changing the selector makes a new key, which
# then needs a new TXT record. Empty disables signing.
HS_DKIM_SELECTOR=hs1

# WhatsApp updates through Meta's WhatsApp Business Platform. Leave all four
# empty and WhatsApp is off (the site hides the option). Setup runbook, the
# two message templates and what each value is: docs/whatsapp.md.
HS_WA_PHONE_ID=
HS_WA_WABA_ID=
HS_WA_TOKEN=
HS_WA_APP_SECRET=
HS_WA_VERIFY_TOKEN=
# Your own WhatsApp number, for the System page's test button.
HS_ADMIN_PHONE=

# Facebook page posting through the Graph API. Leave both empty and posting is
# off. The page id is numeric; the token is a non-expiring Page access token
# (how to get one: docs/facebook.md, "Automatic posting"). Even with these set,
# automatic event and weekend posts stay off until switched on under Settings.
HS_FB_PAGE_ID=
HS_FB_PAGE_TOKEN=
# HS_FB_API_VERSION=v22.0
# HS_WA_API_VERSION=v22.0
# HS_WA_LANG=en
# HS_WA_TEMPLATE_CONFIRM=hs_confirm
# HS_WA_TEMPLATE_DIGEST=hs_digest

# Public URLs (used in emailed links and for CORS).
HS_SITE_URL=https://helderbergsocial.co.za
HS_API_URL=https://api.helderbergsocial.co.za

# Timing. Digests go out at HS_DIGEST_HOUR local time; weekly ones on
# HS_WEEKLY_DAY (0=Sunday … 4=Thursday). Sources are re-checked every
# HS_WATCH_INTERVAL.
HS_TZ=Africa/Johannesburg
HS_DIGEST_HOUR=6
HS_WEEKLY_DAY=4
HS_WATCH_INTERVAL=6h

# Which host address to publish the port on. Keep it the LAN address so only
# the reverse proxy can reach it.
HS_BIND_IP=192.168.111.150

# Break glass: if the authenticator phone AND all backup codes are lost, set
# HS_TOTP_RESET=1 for ONE restart. It wipes the authenticator and every
# session; the next sign-in enrols a new one. Remove it again immediately.
# HS_TOTP_RESET=1

# Version tag baked into the image (deploy.sh sets it from git).
HS_VERSION=dev
