# Copy to .env (never committed). Same token as HS_FB_ROTA_TOKEN in api/.env on the server.
HS_API_URL=https://api.helderbergsocial.co.za
HS_FB_ROTA_TOKEN=
# Browser profile signed in as the page; default %LOCALAPPDATA%\helderberg-social\fb-profile
#HS_FB_PROFILE_DIR=
# 1 = no window (only once the flow is proven; Facebook is warier of headless)
#HS_FB_HEADLESS=0
# Seconds between groups
#HS_FB_PAUSE_MIN=60
#HS_FB_PAUSE_MAX=150
#HS_FB_PAGE_URL=https://www.facebook.com/<the page slug>   # what facebook.com/me resolves to for the page profile
